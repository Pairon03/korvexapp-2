# Local PostgreSQL uses trust only on 127.0.0.1. Never use this in production.
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/fitcore
APP_DATABASE_URL=postgresql://fitcore_app@127.0.0.1:54329/fitcore
APP_URL=http://localhost:3000
# development uses ignored .local/mail as an explicit outbox, not actual delivery.
MAIL_MODE=outbox
RESEND_API_KEY=
MAIL_FROM=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=20000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Configure actual price IDs in subscription_plans before checkout.
WORKER_INTERVAL_MS=30000
